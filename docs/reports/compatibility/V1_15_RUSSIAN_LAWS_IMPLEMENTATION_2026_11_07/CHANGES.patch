+
+	progressiveness = -25
+
+	unlocking_technologies = { nationalism }
+
+	on_enact = {
+		recalculate_pop_ig_support = yes
+	}
+
+	requires_law_or = {
+		law_monarchy
+		law_theocracy
+		law_chiefdom
+	}
+
+	is_visible = {
+		c:RUS ?= this # For Russia and its subjects
+	}
+
+	modifier = {
+		country_authority_add = 100
+		country_support_separatism_resistance_mult = -0.25
+		country_support_separatism_strength_mult = -0.25
+
+		#If primary culture, only apply this value
+		country_acceptance_primary_culture_add = 50
+		country_acceptance_homeland_add = 30
+		country_acceptance_not_homeland_add = 0
+
+		#Heritage
+		#From this block, we only apply the highest value a Pop qualifies for
+		country_acceptance_shared_heritage_trait_add = 10 # Agenda of Russification for other East Slavic peoples
