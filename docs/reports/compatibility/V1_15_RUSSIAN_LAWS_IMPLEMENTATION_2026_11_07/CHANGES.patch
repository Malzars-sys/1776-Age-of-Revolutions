+# Native 1.15 Russian laws restored without replacing shared scenario laws.
+# Third Section remains selectable: the vanilla retirement gate references a
+# consumed technology alias, and its Okhrana successor is outside this lot.
+law_third_section = {
+	group = lawgroup_internal_security
+	parent = law_secret_police # Inherits ideological stances from parent
+	icon = "gfx/interface/icons/law_icons/secret_police.dds"
+
+	progressiveness = -25
+
+	is_visible = {
+		c:RUS ?= this
+		country_has_monarchy_law = yes
+	}
+
+	unlocking_technologies = {
+		professional_civil_policing
+	}
+
+	modifier = {
+		country_officers_pol_str_mult = 0.25
+		country_institution_home_affairs_max_investment_add = -2
+		country_institution_cost_institution_home_affairs_mult = -0.25
+	}
+
+	institution = institution_home_affairs
+	institution_modifier = {
+		country_suppression_attraction_factor = -0.03
+		political_movement_radicalism_add = -0.03
+		country_coup_resistance_add = 0.5
+	}
+
+	on_enact = {
+		custom_tooltip = unlock_arrange_accident_tt
+	}
+
+	ai_enact_weight_modifier = { #Petitions
+		value = 0
+
+		if = {
+			limit = { ai_has_enact_weight_modifier_journal_entries = yes }
+			add = 750
+		}
+	}
+}
+
