--- /dev/null
+++ b/common/amendments/17_1776_russian_noble_legacy.txt
@@ -0,0 +1,22 @@
+# A transitional Russian bureaucracy with continuing landed-noble influence.
+amendment_aor1776_noble_legacy = {
+	parent = law_military_bureaucrats
+	allowed_laws = { law_hereditary_bureaucrats law_military_bureaucrats }
+
+	modifier = {
+		interest_group_ig_landowners_pol_str_mult = 0.15
+	}
+
+	possible = { c:RUS ?= this }
+	would_sponsor = { is_interest_group_type = ig_landowners }
+	ai_will_revoke = {
+		NOT = {
+			any_interest_group = {
+				is_interest_group_type = ig_landowners
+				is_in_government = yes
+			}
+		}
+	}
+	can_repeal = { legitimacy >= legitimacy_to_repeal_amendment }
+	amendment_activism_multiplier = 0.5
+}
