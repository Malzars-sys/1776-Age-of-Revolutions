    "rows": [
      {
        "Secteur": "Ebersdorf–Wurzbach–Oßla",
        "Classe": "C",
        "Probleme": "Quatre cellules de la trace intérieure tombent sur SCW; elles restent inchangées pour préserver le territoire antérieur de Rudolstadt. La résidence d’Ebersdorf seule est quantifiée à une cellule.",
        "Action": "Comparer une pièce locale antérieure à1776 et le calage existant avant tout transfert SCW."
      },
      {
        "Secteur": "Sondershausen occidental",
        "Classe": "C",
        "Probleme": "La trace couvre quatre cellules prussiennes de STATE_BRUNSWICK autour de Keula; elles sont exclues du noyau nord installé.",
        "Action": "Documenter les limites occidentales et leur correspondance au bitmap avant extension."
      },
      {
        "Secteur": "Ebeleben–Clingen",
        "Classe": "C",
        "Probleme": "Le prolongement méridional recoupe le rectangle de protection d’Erfurt, bien plus large que le territoire de cette ville. Aucun pixel du rectangle ne change.",
        "Action": "Maintenir cette réserve tant que la séparation d’Erfurt n’est pas démontrée; aucun corridor vers Gehren."
      },
      {
        "Secteur": "Reuss dispersés",
        "Classe": "C",
        "Probleme": "Altengeß, Heberndorf, Thimmendorf–Ruppersdorf, Titschendorf et bois isolés non intégrés; résidus techniques non certifiés.",
        "Action": "Ne pas prolonger ce lot pour des micro-enclaves; future passe documentée seulement."
      },
      {
        "Secteur": "Saalburg et Burgk",
        "Classe": "C",
        "Probleme": "Les parts de Gera et les possessions de Greiz ne sont pas annexées à Ebersdorf ou Lobenstein. Les limites résiduelles restent incomplètes.",
        "Action": "Conserver les droits antérieurs; ne pas importer le condominium de Gera après1802."
      },
      {
        "Secteur": "Démographie",
        "Classe": "C",
        "Probleme": "Les archives signalent des comparaisons1714/1784, mais leurs valeurs et périmètres n’ont pas été consultés. Les petites populations installées sont techniques.",
        "Action": "Exploiter le dossier0992, fonds3-12-2500, si les images deviennent accessibles; ne pas extrapoler un total1820."
      },
      {
        "Secteur": "Centres urbains et capitales",
        "Classe": "C",
        "Probleme": "Aucun locator propre aux trois villes n’existe dans les régions partagées. Le choix d’une région capitale n’ajoute ni ville physique ni population.",
        "Action": "Vérifier en nouvelle partie le repérage et l’accès au marché; ne pas déplacer automatiquement les locators natifs."
      },
      {
        "Secteur": "Exactitude des frontières",
        "Classe": "C",
        "Probleme": "Les polygones sont des noyaux B, non une restitution cadastrale. L’ajustement des feuilles ne prouve pas une erreur indépendante inférieure à2pixels.",
        "Action": "Conserver le profil diagnostique et ses limites; aucune translation7,20pixels."
      },
      {
        "Secteur": "Erfurt–Eichsfeld et autres lots",
        "Classe": "C",
        "Probleme": "Problèmes historiques et anciens secteurs incomplets restent ouverts; la validation manuelle de MAP2T n’est pas une certification de toutes leurs limites.",
        "Action": "Aucun transfert MAP2U dans les secteurs interdits; lot futur uniquement sur instruction."
      }
    ]
